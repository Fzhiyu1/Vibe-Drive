server:
  port: 8080

spring:
  application:
    name: vibe-drive
  jackson:
    visibility:
      getter: none
      is-getter: none
      field: any
    serialization:
      write-dates-as-timestamps: false
    deserialization:
      fail-on-unknown-properties: false

# LangChain4j Configuration
langchain4j:
  # 模型提供商: openai / anthropic
  provider: openai

  # OpenAI 配置 (也支持 DeepSeek 等兼容 API)
  open-ai:
    chat-model:
      base-url: https://api.openai.com/v1
      api-key: your-api-key-here
      model-name: gpt-4o-mini
      temperature: 0.7
      log-requests: true
      log-responses: true

  # Anthropic 配置
  anthropic:
    chat-model:
      base-url: https://api.anthropic.com
      api-key: your-api-key-here
      model-name: claude-haiku-4-5-20251001
      temperature: 0.7
      log-requests: true
      log-responses: true

# Logging
logging:
  level:
    com.vibe: DEBUG
    dev.langchain4j: DEBUG
  pattern:
    console: "%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n"

# OpenAPI Documentation
springdoc:
  api-docs:
    path: /api-docs
  swagger-ui:
    path: /swagger-ui.html
